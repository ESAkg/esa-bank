# Скопируйте этот файл в .env и заполните, если хотите подключить
# бесплатную онлайн-базу данных (Supabase) вместо локального файла.
# Без этих двух переменных приложение работает в локальном режиме —
# тоже полностью рабочем, но данные тогда хранятся только в файле
# server/db/data.json на том сервере, где запущено приложение.

SUPABASE_URL=
SUPABASE_KEY=

# Порт, на котором поднимается сервер (большинство бесплатных хостингов
# подставляют свой PORT автоматически — тогда эту строку можно не трогать)
PORT=3000
